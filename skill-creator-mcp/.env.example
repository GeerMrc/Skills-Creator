# Skill-Creator MCP Server 环境变量配置示例
# 复制此文件为 .env 并根据需要修改配置

# 日志配置
# SKILL_CREATOR_LOG_LEVEL: 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
SKILL_CREATOR_LOG_LEVEL=INFO

# SKILL_CREATOR_LOG_FORMAT: 日志格式 (default, simple, detailed)
SKILL_CREATOR_LOG_FORMAT=default

# SKILL_CREATOR_LOG_FILE: 日志文件路径（留空则输出到 stderr）
# 使用用户目录（推荐）
# SKILL_CREATOR_LOG_FILE=~/.skill-creator-mcp.log
# 或使用相对路径
# SKILL_CREATOR_LOG_FILE=./logs/skill-creator-mcp.log

# 输出配置
# SKILL_CREATOR_OUTPUT_DIR: 输出目录
# 推荐设置为绝对路径，确保在不同工作目录下行为一致
SKILL_CREATOR_OUTPUT_DIR=~/agent-skills

# SKILL_CREATOR_DEFAULT_OUTPUT_DIR: 默认输出目录（当 OUTPUT_DIR 未设置时）
# 通常与 SKILL_CREATOR_OUTPUT_DIR 保持一致
SKILL_CREATOR_DEFAULT_OUTPUT_DIR=~/agent-skills

# 缓存配置
# SKILL_CREATOR_CACHE_SIZE: 缓存最大条目数
# 推荐值：根据内存调整（64-512）
SKILL_CREATOR_CACHE_SIZE=128

# SKILL_CREATOR_CACHE_TTL: 缓存过期时间（秒）
# 推荐值：根据数据更新频率调整（600-7200）
SKILL_CREATOR_CACHE_TTL=3600

# 计划归档目录
# SKILL_CREATOR_PLAN_ARCHIVE_DIR: 计划归档目录
SKILL_CREATOR_PLAN_ARCHIVE_DIR=.claude/plans/archive

# 操作配置
# SKILL_CREATOR_MAX_RETRIES: 最大重试次数
SKILL_CREATOR_MAX_RETRIES=3

# SKILL_CREATOR_TIMEOUT_SECONDS: 操作超时时间（秒）
SKILL_CREATOR_TIMEOUT_SECONDS=30

# MCP 配置
# SKILL_CREATOR_MCP_PORT: HTTP 模式端口（使用 HTTP 模式时）
# SKILL_CREATOR_MCP_PORT=8000

# 开发配置
# SKILL_CREATOR_DEBUG: 调试模式
# SKILL_CREATOR_DEBUG=false
