# Skill-Creator MCP Server 环境变量配置模板
# 复制此文件为 .env 并根据需要修改配置值

# -----------------------------------------------------------------------------
# 日志配置
# -----------------------------------------------------------------------------

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
# 默认: INFO
SKILL_CREATOR_LOG_LEVEL=INFO

# 日志格式: text, json
# 默认: text
SKILL_CREATOR_LOG_FORMAT=text

# 日志文件路径（可选）
# 如果设置，日志将输出到文件而不是标准输出
# SKILL_CREATOR_LOG_FILE=/var/log/skill-creator.log

# -----------------------------------------------------------------------------
# 输出配置
# -----------------------------------------------------------------------------

# 默认输出目录
# 用于技能初始化、打包等操作的默认输出位置
# 默认: 当前目录
SKILL_CREATOR_OUTPUT_DIR=.

# -----------------------------------------------------------------------------
# 性能配置
# -----------------------------------------------------------------------------

# 最大重试次数
# 用于网络请求或 LLM 调用失败时的重试
# 默认: 3
SKILL_CREATOR_MAX_RETRIES=3

# 超时时间（秒）
# 用于 LLM 调用等操作的超时时间
# 默认: 30
SKILL_CREATOR_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# LLM 配置（可选）
# -----------------------------------------------------------------------------

# LLM API 密钥（如果使用需要 API 密钥的 LLM 服务）
# ANTHROPIC_API_KEY=your_api_key_here
# OPENAI_API_KEY=your_api_key_here

# LLM 模型名称（可选）
# 用于需求收集等功能
# SKILL_CREATOR_LLM_MODEL=claude-3-5-sonnet-20241022

# -----------------------------------------------------------------------------
# 开发配置
# -----------------------------------------------------------------------------

# 开发模式: true, false
# 启用时会显示更详细的调试信息
# 默认: false
SKILL_CREATOR_DEV_MODE=false

# -----------------------------------------------------------------------------
# 示例配置
# -----------------------------------------------------------------------------

# 开发环境配置示例
# SKILL_CREATOR_LOG_LEVEL=DEBUG
# SKILL_CREATOR_DEV_MODE=true
# SKILL_CREATOR_OUTPUT_DIR=./output

# 生产环境配置示例
# SKILL_CREATOR_LOG_LEVEL=WARNING
# SKILL_CREATOR_LOG_FORMAT=json
# SKILL_CREATOR_LOG_FILE=/var/log/skill-creator.log
